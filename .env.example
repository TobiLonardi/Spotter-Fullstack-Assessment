# Copy to project root as .env and adjust:
#   copy .env.example .env   (Windows, from repo root)
#   cp .env.example .env     (Unix)

# --- Django (backend) ---
# Required in production. For local dev you can omit and use Django fallback.
SECRET_KEY=change-me-to-a-long-random-string

# true / false (default: true if unset)
DEBUG=True

# Comma-separated hostnames (no spaces after commas)
ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to call the API (CORS). Comma-separated URLs.
# Omit this variable entirely to use the default Vite dev URLs.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
#
# --- Vercel (backend project: Root Directory = backend) ---
# Set on the Vercel project; .env may be absent on the server. Backend needs app.py + vercel.json in repo.
# ALLOWED_HOSTS is optional if VERCEL is set (.vercel.app is added in settings); you can still set a specific host.
# Point the frontend VITE_API_URL at this API origin, then redeploy the frontend.

# --- TomTom Routing (backend trip routing) ---
# Developer portal: https://developer.tomtom.com/
# Enable "Routing API" for your key. Uses travelMode=truck first; falls back to car.
TOMTOM_API_KEY=

# --- Frontend (Vite; variables must be prefixed with VITE_) ---
# Optional API origin for fetch(). Leave empty for relative URLs (Vite dev proxy).
# VITE_API_URL=https://api.example.com
VITE_API_URL=
